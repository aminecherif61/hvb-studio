# ── HVB Vault — environment template ────────────────────────────────
# Copy to .env and fill in. Every secret must be unique per environment.

# SQLite for local dev; PostgreSQL in production, e.g.
#   postgresql://user:pass@host:5432/hvb?sslmode=require
# (switch provider in prisma/schema.prisma to "postgresql" and re-run migrate)
DATABASE_URL="file:./dev.db"

# Canonical origin of the site (scheme matters — controls Secure cookies)
APP_URL="http://localhost:3100"

# JWT signing key — `openssl rand -base64 48`
AUTH_SECRET=""

# AES-256-GCM key for TOTP secrets at rest — `openssl rand -base64 32`
ENCRYPTION_KEY=""

# ── Admin sign-in (no database required) ───────────────────────────
# The console has one owner, held here rather than in a users table.
ADMIN_EMAIL=""

# Argon2id hash of the password, base64-encoded. Base64 matters: a raw PHC
# string contains `$` sequences that dotenv-expand (used by Next.js) rewrites
# as variable references, which silently breaks verification.
# Generate:
#   node -e 'const{argon2id}=require("hash-wasm");const{randomBytes}=require("crypto");
#   argon2id({password:"YOUR_PASSWORD",salt:randomBytes(16),parallelism:1,iterations:2,
#   memorySize:19456,hashLength:32,outputType:"encoded"}).then(h=>console.log(Buffer.from(h).toString("base64")))'
ADMIN_PASSWORD_HASH_B64=""

# Authorizes the one-time /api/admin/bootstrap call (only needed when you
# attach a database and want the schema created). `openssl rand -base64 32`
BOOTSTRAP_SECRET=""

# Directory for optimized uploads (outside public/ — served via /media/*)
UPLOADS_DIR=".uploads"

# SMTP for password-reset mail. When SMTP_HOST is empty the reset link is
# printed to the server console instead (dev only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HVB Studio <no-reply@example.com>"
